/* ------------------------------------------------------------------ */
/* Service Desk: Database Schema Validation                           */
/* ------------------------------------------------------------------ */

test('service_tickets table exists with composite FK', () => {
  assert.match(schema, /service_tickets_customer_fk.*FOREIGN KEY.*business_id.*customer_id.*REFERENCES.*customers.*business_id.*id/)
})

test('service_ticket_comments has composite FK to service_tickets', () => {
  assert.match(schema, /service_ticket_comments_ticket_fk.*FOREIGN KEY.*business_id.*ticket_id.*REFERENCES.*service_tickets.*business_id.*id/)
})

test('service_ticket_events has composite FK to service_tickets', () => {
  assert.match(schema, /service_ticket_events_ticket_fk.*FOREIGN KEY.*business_id.*ticket_id.*REFERENCES.*service_tickets.*business_id.*id/)
})

test('service_ticket_attachments has composite FK to service_tickets', () => {
  assert.match(schema, /service_ticket_attachments_ticket_fk.*FOREIGN KEY.*business_id.*ticket_id.*REFERENCES.*service_tickets.*business_id.*id/)
})

test('service_level_policies has FK to businesses', () => {
  assert.match(schema, /service_level_policies_business_fk.*FOREIGN KEY.*business_id.*REFERENCES.*businesses.*id/)
})

test('business_invitations has FK to businesses', () => {
  assert.match(schema, /business_invitations_business_fk.*FOREIGN KEY.*business_id.*REFERENCES.*businesses.*id/)
})

test('business_invitations has unique constraint on business_id + email', () => {
  assert.match(schema, /business_invitations_email_business_uq.*UNIQUE.*business_id.*email/)
})

test('business_invitations has token_hash column', () => {
  assert.match(schema, /token_hash.*text.*NOT NULL/)
})

test('business_invitations has expires_at column', () => {
  assert.match(schema, /expires_at.*TIMESTAMPTZ.*NOT NULL/)
})

test('business_invitations has status CHECK constraint', () => {
  assert.match(schema, /business_invitations_status_valid.*CHECK.*status.*IN.*pending.*accepted.*expired.*revoked/)
})

test('service_tickets has status CHECK constraint', () => {
  assert.match(schema, /service_tickets_status_valid.*CHECK.*status.*IN.*open.*in_progress.*on_hold.*resolved.*closed.*cancelled/)
})

test('service_tickets has priority CHECK constraint', () => {
  assert.match(schema, /service_tickets_priority_valid.*CHECK.*priority.*IN.*low.*normal.*high.*critical.*urgent/)
})

test('service_ticket_comments has is_internal column', () => {
  assert.match(schema, /is_internal.*boolean.*NOT NULL.*DEFAULT.*FALSE/)
})

test('service_ticket_events has metadata JSONB', () => {
  assert.match(schema, /metadata.*jsonb.*NOT NULL.*DEFAULT.*\{\}/)
})

/* ------------------------------------------------------------------ */
/* Service Desk: Permission Matrix                                    */
/* ------------------------------------------------------------------ */

test('Permissions: service_ticket.create defined', () => {
  assert.match(permissions, /'service_ticket\.create'/)
})

test('Permissions: service_ticket.read defined', () => {
  assert.match(permissions, /'service_ticket\.read'/)
})

test('Permissions: service_ticket.update defined', () => {
  assert.match(permissions, /'service_ticket\.update'/)
})

test('Permissions: service_ticket.assign defined', () => {
  assert.match(permissions, /'service_ticket\.assign'/)
})

test('Permissions: service_ticket.resolve defined', () => {
  assert.match(permissions, /'service_ticket\.resolve'/)
})

test('Permissions: service_ticket.close defined', () => {
  assert.match(permissions, /'service_ticket\.close'/)
})

test('Permissions: service_ticket.comment_internal defined', () => {
  assert.match(permissions, /'service_ticket\.comment_internal'/)
})

test('Role matrix: owner has all 7 service desk permissions', () => {
  const ownerBlock = permissions.match(/owner: \[[\s\S]*?\]/)
  assert.ok(ownerBlock)
  const perms = [
    'service_ticket.create', 'service_ticket.read', 'service_ticket.update',
    'service_ticket.assign', 'service_ticket.resolve', 'service_ticket.close',
    'service_ticket.comment_internal'
  ]
  perms.forEach(p => assert.match(ownerBlock[0], new RegExp(p.replace('.', '\\.'))))
})

test('Role matrix: viewer has only service_ticket.read', () => {
  const viewerBlock = permissions.match(/viewer: \[[\s\S]*?\]/)
  assert.ok(viewerBlock)
  assert.match(viewerBlock[0], /'service_ticket\.read'/)
  assert.doesNotMatch(viewerBlock[0], /'service_ticket\.create'/)
  assert.doesNotMatch(viewerBlock[0], /'service_ticket\.assign'/)
  assert.doesNotMatch(viewerBlock[0], /'service_ticket\.close'/)
})

test('Role matrix: cashier has service_ticket.read only', () => {
  const cashierBlock = permissions.match(/cashier: \[[\s\S]*?\]/)
  assert.ok(cashierBlock)
  assert.match(cashierBlock[0], /'service_ticket\.read'/)
  assert.doesNotMatch(cashierBlock[0], /'service_ticket\.create'/)
  assert.doesNotMatch(cashierBlock[0], /'service_ticket\.assign'/)
})

test('Role matrix: sales_officer has create, read, update, resolve, comment_internal', () => {
  const salesBlock = permissions.match(/sales_officer: \[[\s\S]*?\]/)
  assert.ok(salesBlock)
  const perms = ['create', 'read', 'update', 'resolve', 'comment_internal']
  perms.forEach(p => assert.match(salesBlock[0], new RegExp(`service_ticket\\.${p}`)))
);

/* ------------------------------------------------------------------ */
/* Service Desk: Audit Logging                                        */
/* ------------------------------------------------------------------ */

test('Key mutations call insertAudit', () => {
  const mutations = [
    'createBusinessInvitation',
    'createServiceLevelPolicy',
    'createServiceTicket',
    'updateServiceTicket',
    'assignServiceTicket',
    'resolveServiceTicket',
    'closeServiceTicket',
    'addServiceTicketComment',
    'createClientServiceTicket',
    'addClientServiceTicketComment',
  ]
  mutations.forEach(fn => {
    const fnMatch = serviceDeskActions.match(new RegExp(`${fn}.*?\\{([\\s\\S]*?)\\n\\}`, 'm'))
    if (fnMatch) {
      assert.match(fnMatch[1], /await insertAudit\(/)
    }
  })
})

/* ------------------------------------------------------------------ */
/* Service Desk: Client Portal Isolation                              */
/* ------------------------------------------------------------------ */

test('createClientServiceTicket derives businessId from membership', () => {
  assert.match(serviceDeskActions, /createClientServiceTicket.*businessMemberships/)
  assert.match(serviceDeskActions, /eq\(businessMemberships\.userId, userId\)/)
  assert.match(serviceDeskActions, /eq\(businessMemberships\.status, 'active'\)/)
})

test('createClientServiceTicket requires customer record', () => {
  assert.match(serviceDeskActions, /createClientServiceTicket.*customers/)
  assert.match(serviceDeskActions, /eq\(customers\.businessId, membership\.businessId\)/)
  assert.match(serviceDeskActions, /eq\(customers\.userId, userId\)/)
})

/* ------------------------------------------------------------------ */
/* Service Desk: Invitation Security                                  */
/* ------------------------------------------------------------------ */

test('createBusinessInvitation hashes token with SHA-256', () => {
  assert.match(serviceDeskActions, /createHash\('sha256'\)/)
  assert.match(serviceDeskActions, /\.update\(token\)\.digest\('hex'\)/)
})

test('createBusinessInvitation checks existing pending invitation', () => {
  assert.match(serviceDeskActions, /const \[existing\] = await db[\s\S]*?businessInvitations[\s\S]*?status.*pending/)
})

test('acceptBusinessInvitation validates token hash', () => {
  assert.match(serviceDeskActions, /tokenHash.*createHash\('sha256'\)/)
})

test('acceptBusinessInvitation checks expiry', () => {
  assert.match(serviceDeskActions, /new Date\(\) > new Date\(invitation\.expiresAt\)/)
})

test('acceptBusinessInvitation checks status pending', () => {
  assert.match(serviceDeskActions, /invitation\.status !== 'pending'/)
})

test('revokeBusinessInvitation only allows pending', () => {
  assert.match(serviceDeskActions, /revokeBusinessInvitation[\s\S]*?invitation\.status !== 'pending'/)
})

test('resendBusinessInvitation generates new token', () => {
  assert.match(serviceDeskActions, /resendBusinessInvitation[\s\S]*?randomBytes/)
  assert.match(serviceDeskActions, /resendBusinessInvitation[\s\S]*?createHash\('sha256'\)/)
})

/* ------------------------------------------------------------------ */
/* Service Desk: SLA Policy Default Enforcement                       */
/* ------------------------------------------------------------------ */

test('createServiceLevelPolicy unsets other defaults', () => {
  assert.match(serviceDeskActions, /if \(isDefault\) \{[\s\S]*?serviceLevelPolicies[\s\S]*?isDefault: false/)
})

test('updateServiceLevelPolicy unsets other defaults', () => {
  assert.match(serviceDeskActions, /if \(input\.isDefault === true\) \{[\s\S]*?serviceLevelPolicies[\s\S]*?isDefault: false/)
})

test('deleteServiceLevelPolicy prevents deleting default', () => {
  assert.match(serviceDeskActions, /deleteServiceLevelPolicy[\s\S]*?if \(policy\.isDefault\) throw/)
})